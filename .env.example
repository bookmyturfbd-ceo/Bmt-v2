# ——— Book My Turf - Environment Variables Template ———
# Copy this file to '.env' and fill in your actual values.
# NEVER commit the actual '.env' file containing real secret keys to Git.

# Database Connections (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# App Secret — used for session tokens
BMT_SECRET="your-app-secret-string-here"

# Supabase CDN Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Mux Video API Keys
MUX_TOKEN_ID="your-mux-token-id"
MUX_TOKEN_SECRET="your-mux-token-secret"

# Onecodesoft SMS API
ONECODESOFT_API_KEY="your-onecodesoft-api-key"
ONECODESOFT_SENDER_ID="your-sender-id"

# Meta Pixel & Conversions API (CAPI)
NEXT_PUBLIC_META_PIXEL_ID="your-meta-pixel-id"
META_CAPI_ACCESS_TOKEN="your-meta-capi-token"
META_TEST_EVENT_CODE=""

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_GROUP_ID="your-telegram-group-id"
TELEGRAM_OWNER_CHAT_ID="your-owner-chat-id"

# Steadfast Courier Integration
STEADFAST_API_KEY="your-steadfast-api-key"
STEADFAST_SECRET_KEY="your-steadfast-secret-key"
STEADFAST_BEARER_TOKEN="your-steadfast-bearer-token"

# OneSignal Push Notifications
NEXT_PUBLIC_ONESIGNAL_APP_ID="your-onesignal-app-id"
ONESIGNAL_REST_API_KEY="your-onesignal-rest-api-key"
